# config/redact_local.yaml — 本部署自己的敏感词表 (出站闸 + 交付脱敏)
#
#   cp config/redact_local.yaml.example config/redact_local.yaml
#
# 真实文件 gitignored —— 这里填的是**你们自己**要保护的真名 / 客户名 / 机构名,
# 属于本部署的机密, 不该进 git。不配也能跑 (下面三项都可留空)。
#
# ⚠️ 上游 boss-vault 的这份表里写死了它自己的锚点真名与客户名。剥离本仓时**已全部移除**
#    —— 那些名字在本部署里保护不了任何东西, 却会把它们泄露给本仓的每一个读者。
#    出站闸的**结构性**规则 (精确财务数字 / lark:// 深链 / case_id …) 原样保留在代码里。

# ─── 出站内容闸: 命中即**不发原文** (fail-close) ───
# 纯字符串, 大小写不敏感, 无需转义正则。
blocked_terms: []
  # - 某某集团              # 例: 不该出现在周报诊断卡片里的客户名
  # - 张三                  # 例: 不该外发的真名

# ─── 出站文件名闸: 附件文件名命中即不发 ───
# (内容脱干净了但文件名带机密词, 一样会泄露 —— 附件名会进对方的下载记录。)
blocked_filename_terms: []
  # - neimu

# ─── 交付脱敏: 报告落盘/渲染前把左边替换成右边 (transform, 不阻断) ───
mask_names: {}
  # 王五: 成员A
