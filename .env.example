# .env.example — 拷成 .env 后填值, 并 chmod 600
#
#   cp .env.example .env && chmod 600 .env
#
# ⚠️ 追加凭据一律用 printf 追加, 不要手写留空的 `KEY=` 行 ——
#    `set -a` 后同名变量**后定义覆盖先定义**, 空值会覆盖真值,
#    表现为飞书报 10014 app secret invalid, 极难查。
#      printf 'LARK_APP_ID_STUDY_WEEKLY=%s\n' 'cli_xxx' >> .env
#      grep -c '^LARK_APP_ID_STUDY_WEEKLY=' .env     # 必须是 1

# ─── 飞书自建应用 (必填) ───────────────────────────────────────
# 飞书开放平台 → 创建企业自建应用 → 凭证与基础信息
LARK_APP_ID_STUDY_WEEKLY=
LARK_APP_SECRET_STUDY_WEEKLY=

# ─── LLM (必填) ───────────────────────────────────────────────
# provider: anthropic | anthropic-compatible | openai-compatible
BOSS_LLM_PROVIDER=anthropic
BOSS_LLM_API_KEY=
BOSS_LLM_MODEL_DEEP=
# ⚠️ BOSS_LLM_BASE_URL 对**任何** provider 都会先读 ——
#    从自建网关切回官方时务必删掉这行, 否则请求仍打到旧网关。
# BOSS_LLM_BASE_URL=

# ─── 时区 (必填) ──────────────────────────────────────────────
# 不设会让「本周」归属算错档 (汇总用本地 datetime.now())
TZ=Asia/Shanghai

# ─── 可选 ─────────────────────────────────────────────────────
# 白名单。scene.yaml 里 group_open + trust_p2p 均为 true 时不查白名单,
# 只留配额 (30 单/人/日, 按 UTC 日计; 失败与被拦的 job 也占额度)。
# STUDY_WEEKLY_WHITELIST=
